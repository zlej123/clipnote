{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Investment claim extraction only. Verification state is system-owned and intentionally absent.",
  "title": "clipnote investment claim packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "summary", "claims"],
  "properties": {
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "claim_type",
          "speaker",
          "epistemic_mode",
          "entities",
          "source_anchor",
          "time_horizon",
          "decision_impact",
          "verification_feasibility",
          "verification_questions",
          "falsification_questions"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^claim-[1-9][0-9]*$"},
          "statement": {"type": "string"},
          "claim_type": {
            "enum": [
              "factual_claim",
              "inference",
              "prediction",
              "opinion",
              "rumor",
              "recommendation"
            ]
          },
          "speaker": {"type": "string"},
          "epistemic_mode": {
            "enum": ["asserted", "speculated", "quoted_third_party"]
          },
          "entities": {
            "type": "array",
            "items": {"type": "string"}
          },
          "source_anchor": {
            "type": "object",
            "additionalProperties": false,
            "required": ["quote", "timestamp_start", "timestamp_end"],
            "properties": {
              "quote": {"type": "string", "minLength": 4},
              "timestamp_start": {
                "type": "string",
                "pattern": "^[0-9]{1,3}:[0-9]{2}$"
              },
              "timestamp_end": {
                "type": "string",
                "pattern": "^[0-9]{1,3}:[0-9]{2}$"
              }
            }
          },
          "time_horizon": {
            "oneOf": [
              {"type": "string"},
              {"type": "null"}
            ]
          },
          "decision_impact": {"type": "integer", "minimum": 1, "maximum": 3},
          "verification_feasibility": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "verification_questions": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "falsification_questions": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
